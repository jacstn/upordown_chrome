{
  "manifest_version": 3,
  "name": "Polymarket Trading Panel",
  "version": "1.3.50",
  "description": "Adds a native 212-server trading panel to live Polymarket chart pages.",
  "permissions": ["storage", "sidePanel", "contextMenus", "scripting"],
  "host_permissions": [
    "https://upordown.pl/*",
    "http://212.227.107.122:4429/*",
    "https://212.227.107.122:4430/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-64.png",
    "32": "icon-64.png",
    "48": "icon-64.png",
    "64": "icon-64.png"
  },
  "content_scripts": [
    {
      "matches": ["https://upordown.pl/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon-128.png"],
      "matches": ["https://upordown.pl/*"]
    }
  ],
  "action": {
    "default_title": "Open Polymarket Trading Panel",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-64.png",
      "32": "icon-64.png"
    }
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
